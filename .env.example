# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# ── SMTP (outbound email) ────────────────────────────────────────────────────
# Used by /api/contact and /api/notify to send emails.
# If these are not set, submissions are logged to the console instead.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=operation.vod@gmail.com
#   SMTP_PASS=<Gmail App Password — not your account password>
#   SMTP_TO=operation.vod@gmail.com
#
# To get a Gmail App Password:
#   Google Account → Security → 2-Step Verification → App passwords

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# ── PayPal Donate ────────────────────────────────────────────────────────────
# Your PayPal business email. Used to pre-fill the PayPal donate URL.
NEXT_PUBLIC_PAYPAL_EMAIL=

# ── QPay (Mongolian QR payment) ──────────────────────────────────────────────
# Get these from your QPay merchant dashboard at merchant.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# ── Site URL (used for QPay callback) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://voiceofdesert.org
