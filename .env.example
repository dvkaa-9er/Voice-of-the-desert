# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# ── SMTP (outbound email) ────────────────────────────────────────────────────
# Used by /api/contact and /api/notify to send emails.
# If these are not set, submissions are logged to the console instead.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=operation.vod@gmail.com
#   SMTP_PASS=<Gmail App Password — not your account password>
#   SMTP_TO=operation.vod@gmail.com
#
# To get a Gmail App Password:
#   Google Account → Security → 2-Step Verification → App passwords

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# ── PayPal Donate ────────────────────────────────────────────────────────────
# Hosted button ID from paypal.com/donate — get it from your PayPal dashboard.
# URL format: https://www.paypal.com/donate/?hosted_button_id=XXXX
NEXT_PUBLIC_PAYPAL_BUTTON_ID=W4TH5XGD5TVNL

# ── QPay (Mongolian QR payment) ──────────────────────────────────────────────
# Get these from your QPay merchant dashboard at merchant.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# ── Stripe (card / Apple Pay / Google Pay) ──────────────────────────────────
# Create a Payment Link at dashboard.stripe.com → Payment Links
# Example: https://buy.stripe.com/xxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# ── SocialPay (Khan Bank) ────────────────────────────────────────────────────
# Get merchant code from Khan Bank → socialpay.mn merchant portal
NEXT_PUBLIC_SOCIALPAY_MERCHANT=

# ── MonPay ───────────────────────────────────────────────────────────────────
# Get merchant ID from monpay.mn merchant portal
NEXT_PUBLIC_MONPAY_MERCHANT=

# ── Site URL (used for QPay callback) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://voiceofdesert.org
