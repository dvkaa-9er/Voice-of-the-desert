# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# ── SMTP (outbound email) ────────────────────────────────────────────────────
# Used by /api/contact and /api/notify to send emails.
# If these are not set, submissions are logged to the console instead.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=operation.vod@gmail.com
#   SMTP_PASS=<Gmail App Password — not your account password>
#   SMTP_TO=operation.vod@gmail.com
#
# To get a Gmail App Password:
#   Google Account → Security → 2-Step Verification → App passwords

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TO=
